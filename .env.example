# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Leave PRIVATE_KEY unset (or DRY_RUN=true) to simulate: real book, real decisions, orders rest until
# replaced or filled when a real print crosses their price.
PRIVATE_KEY=
DRY_RUN=true

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# The model is asked whether MON will be higher or lower than the mid after this many blocks
# (~300 ms each; the default 100 is ~30 s).
HORIZON_BLOCKS=100

# The model decides every block. New post-only orders use this size and sit this many ticks inside
# the touch (0 joins the best bid/ask). Kuru MON-USDC minimum order is 200 MON; tick is 0.000001.
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
# Keep a full-size order on the model's side while its price is within REQUOTE_TICKS of a new quote.
# Kept blocks send no transaction and pay no gas. Set true to replace the order every block instead.
QUOTE_EVERY_BLOCK=false
REQUOTE_TICKS=5
MAX_POSITION_MON=1000
BANKROLL_USD=100

# Kuru limit orders draw from the margin account, not the wallet. At startup the bot deposits enough to
# reach these balances. Asks need MON, bids need USDC. Proceeds of fills also land in margin.
MARGIN_MON=600
MARGIN_USDC=20
# Legacy Kuru V1 OrderBook (MON-USDC). The default book had no bids on 2026-10-30.
# Spot V2 uses different custody, calldata and events; changing these addresses is not a migration.
# Run `bun run check:market` before attempting to collect forecasts or trade.
# The margin account below must match this legacy market.
MARKET=0x065C9d28E428A0db40191a54d33d5b7c71a9C394
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, used or not, and eth_estimateGas never runs in the loop. One place is
# estimated once at startup (needs margin funds) and each tx gets that + GAS_HEADROOM, plus GAS_PER_CANCEL
# for each order it cancels (if the estimate fails: 325000 + GAS_PER_CANCEL each). ~0.034 MON per update.
# A limit too tight for the tx reverts out of gas and is still charged in full.
GAS_HEADROOM=0.1
GAS_PER_CANCEL=25000
# Fixed limit for every tx instead (overrides the two above).
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

PORT=3000

# Book-inspired execution gate. Jev still forecasts every block; orders can be skipped.
STRATEGY_ENABLED=true
# Matured, non-overlapping shadow attempts per side/confidence/offset/volatility bucket.
STRATEGY_MIN_SAMPLES=30
STRATEGY_MIN_FILLS=10
MIN_EDGE_USD=0.001
EDGE_UNCERTAINTY=2
# Conservative allowance for eventual liquidation, including taker fee and price impact.
EXIT_COST_BPS=10
MAX_LOSS_USD=5
MAX_VOL_BPS=30
RECORD_RESEARCH=true
# Optional signed accounting override: positive = cost, negative = rebate.
# Blank uses the legacy Kuru on-chain maker rebate, normalized to a negative cost.
MAKER_FEE_BPS=
